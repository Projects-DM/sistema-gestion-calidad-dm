# ==============================================================================
# 🛡️ ARCHIVO DE CONFIGURACIÓN DE ENTORNO (PLANTILLA OFICIAL)
# Proyecto: Sistema de Gestión de Calidad (SGC) - DM Distribuciones
#
# INSTRUCCIONES:
# 1. Copie este archivo y renombre la copia como ".env" en la raíz del proyecto.
#    $ cp .env.example .env
# 2. Reemplace los valores vacíos con las credenciales reales de sus servidores.
#
# ⚠️ ADVERTENCIA DE SEGURIDAD:
# * NUNCA incluya claves privadas o secretos de producción (como 'service_role_key')
#   en este archivo. Solo declare variables con prefijo 'VITE_' que son seguras 
#   para ser expuestas públicamente en el frontend.
# * Este archivo (.env.example) DEBE mantenerse en el repositorio de Git.
# * El archivo final (.env) que contiene credenciales reales NUNCA debe subirse
#   a Git (ya se encuentra protegido en el archivo .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NÚCLEO DE SUPABASE (CONEXIÓN Y AUTENTICACIÓN) - [MANDATORIO]
# ------------------------------------------------------------------------------

# Propósito: URL del endpoint del proyecto Supabase.
# Impacto: Define a qué base de datos PostgreSQL y API REST se conectará la SPA.
# Obligatorio: Sí.
# Formato: https://<project-id>.supabase.co
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Propósito: Clave API anónima pública (Anon Key).
# Impacto: Permite realizar peticiones HTTP seguras desde el navegador utilizando 
#          el protocolo de autenticación GoTrue de Supabase y las políticas RLS.
# Obligatorio: Sí.
# Formato: String JWT largo que inicia con 'eyJ...'
VITE_SUPABASE_ANON_KEY=tu-api-key-anonima-publica

# ------------------------------------------------------------------------------
# 2. METADATOS Y ENTORNO GENERAL DE LA APP - [OPCIONAL]
# ------------------------------------------------------------------------------

# Propósito: Nombre oficial de la aplicación que se renderiza en títulos y layouts.
# Impacto: Personalización estética de la interfaz sin modificar código.
# Obligatorio: No.
# Valor por defecto: "SGC - DM Distribuciones"
VITE_APP_NAME="SGC - DM Distribuciones"

# Propósito: Flag del ambiente de ejecución del frontend.
# Impacto: Controla si se muestran logs detallados y advertencias en la consola del navegador.
# Obligatorio: No.
# Opciones: development | staging | production
# Valor por defecto: development
VITE_APP_ENV=development

# Propósito: URL del servidor backend API (para futuras integraciones personalizadas).
# Impacto: Define el endpoint para microservicios especializados o sincronizaciones con ERPs.
# Obligatorio: No (el núcleo opera directamente con Supabase).
# Formato: https://api.midominio.com/v1
VITE_API_URL=

# ------------------------------------------------------------------------------
# 3. ALMACENAMIENTO DE ARCHIVOS (SUPABASE STORAGE) - [RECOMENDADO]
# ------------------------------------------------------------------------------

# Propósito: Nombre del bucket configurado en Supabase Storage para multimedia.
# Impacto: Define la ruta de almacenamiento de fotos de evidencias, firmas y documentos.
# Obligatorio: No.
# Valor por defecto: "documentos-sgc"
VITE_SUPABASE_STORAGE_BUCKET=documentos-sgc

# Propósito: Límite máximo de peso permitido para la subida de evidencias.
# Impacto: Previene consumo excesivo de banda y storage del bucket.
# Obligatorio: No.
# Formato: Número entero en Megabytes.
# Valor por defecto: 10
VITE_MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 4. CONTROL DE COMPORTAMIENTO (FEATURE FLAGS & MOCKS) - [DESARROLLO]
# ------------------------------------------------------------------------------

# Propósito: Alternar el uso de datos en duro (mocks) ante la falta de conexión Supabase.
# Impacto: Si es true, el sistema usará fallback locales si no detecta red o un .env válido.
# Obligatorio: No.
# Opciones: true | false
# Valor por defecto: false
VITE_ENABLE_MOCK_FALLBACKS=false

# Propósito: Habilitar/Deshabilitar visualización del panel de auditoría (logs) en UI.
# Impacto: Oculta o muestra la pestaña de trazabilidad de auditoría a los inspectores.
# Obligatorio: No.
# Opciones: true | false
# Valor por defecto: true
VITE_ENABLE_AUDIT_VIEW=true

# Propósito: Activar modo de mantenimiento en la aplicación.
# Impacto: Muestra una pantalla de bloqueo preventivo por actualizaciones de base de datos.
# Obligatorio: No.
# Opciones: true | false
# Valor por defecto: false
VITE_MAINTENANCE_MODE=false

# ------------------------------------------------------------------------------
# 5. INTEGRACIONES Y MONITOREO FUTURO (LOGS, MAILING Y ANALYTICS) - [ESCALABILIDAD]
# ------------------------------------------------------------------------------

# Propósito: DSN de Sentry para reporte automático de errores en producción.
# Impacto: Captura excepciones silenciosas en el navegador y las reporta para debugging.
# Obligatorio: No.
# Formato: https://<key>@<org>.ingest.sentry.io/<project-id>
VITE_SENTRY_DSN=

# Propósito: Identificador de Google Analytics 4 o servicio de telemetría.
# Impacto: Mide la tasa de uso, flujos y conversiones de los operarios.
# Obligatorio: No.
# Formato: G-XXXXXXXXXX
VITE_ANALYTICS_MEASUREMENT_ID=

# Propósito: Correo de soporte técnico institucional para los layouts de error.
# Impacto: Habilita enlaces rápidos de contacto en caso de fallos del sistema.
# Obligatorio: No.
# Valor por defecto: soporte.sgc@dmdistribuciones.com
VITE_SUPPORT_EMAIL=soporte.sgc@dmdistribuciones.com
